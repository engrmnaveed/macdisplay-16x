#!/bin/zsh
# Prepares a release, the first of the two steps in docs/release.md. Run it on a branch cut
# from origin/main once a milestone is merged there. It commits nothing.
#
#   scripts/prepare-release X.Y.Z
#
# It writes X.Y.Z to scripts/release-version, turns the "## Unreleased" section of
# CHANGELOG.md into "## X.Y.Z" with a new, empty "## Unreleased" above it, and moves the
# version in the examples of docs/install.md. Then edit the new section for someone who uses
# the app, run the checks and open a pull request. scripts/tag-release is the second step.
set -euo pipefail
cd "${0:A:h:h}"

fail() {
    print -u2 "prepare-release: $1"
    exit 1
}

new="${1:-}"
[[ $# -eq 1 && "$new" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || fail "usage: scripts/prepare-release X.Y.Z"
old="$(<scripts/release-version)"

# True when $1 is a later version than $2, compared number by number.
later() {
    local -a a b
    a=("${(@s:.:)1}")
    b=("${(@s:.:)2}")
    local i
    for i in 1 2 3; do
        (( a[i] > b[i] )) && return 0
        (( a[i] < b[i] )) && return 1
    done
    return 1
}
later "$new" "$old" || fail "$new is not later than $old, the version in scripts/release-version"
[[ -z "$(git status --porcelain)" ]] || fail "the working tree has changes. Start from a clean branch cut from origin/main"
if git rev-parse -q --verify "refs/tags/v$new" >/dev/null; then
    fail "the tag v$new exists already"
fi
if grep -qx "## $new" CHANGELOG.md; then
    fail "CHANGELOG.md has a '## $new' section already"
fi
grep -qx "## Unreleased" CHANGELOG.md || fail "CHANGELOG.md has no '## Unreleased' section to release"
unreleased="$(awk '$0 == "## Unreleased" { found = 1; next } found && /^## / { exit } found && NF { print }' CHANGELOG.md)"
[[ -n "$unreleased" ]] || fail "the '## Unreleased' section of CHANGELOG.md is empty, so there is nothing to release"

print -r -- "$new" > scripts/release-version

awk -v version="$new" '
    !done && $0 == "## Unreleased" { print; print ""; print "## " version; done = 1; next }
    { print }
' CHANGELOG.md > CHANGELOG.md.new
mv CHANGELOG.md.new CHANGELOG.md

sed -i '' -E \
    -e "s/display16x-[0-9]+\.[0-9]+\.[0-9]+-macos-arm64/display16x-$new-macos-arm64/g" \
    -e "s/use version [0-9]+\.[0-9]+\.[0-9]+ as an example/use version $new as an example/" \
    docs/install.md

print "Prepared $new (scripts/release-version said $old):"
git --no-pager diff --stat
print "
Next, as docs/release.md describes:
  1. Edit the '## $new' section of CHANGELOG.md for someone who uses the app, and say what
     was checked on hardware and what was not.
  2. If the signing level changes with this release, update the signing paragraphs at the top
     of docs/install.md and in the Install section of README.md.
  3. Preview the notes: scripts/release-notes $new LEVEL, where LEVEL is the level the
     release-signing environment gives (certificate, developer-id or adhoc).
  4. Run the checks, commit, open a pull request into main and merge it once CI passes.
  5. scripts/tag-release $new"
